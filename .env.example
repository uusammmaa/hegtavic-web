# ── Site ───────────────────────────────────────────────────
# The public origin, used for canonicals, sitemap and OG images.
# Optional on Vercel: the deployment host is detected automatically
# (see app/layout.tsx). Set it explicitly at launch, and always when
# hosting anywhere other than Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Contact form ───────────────────────────────────────────
# ALL THREE are required for the form to deliver. With any one
# missing the form accepts input and then reports a server error to
# the visitor, with the only evidence in the server log.
RESEND_API_KEY=
# Where enquiries are delivered.
CONTACT_TO_EMAIL=info@hegtavic.com
# Must be an address on a domain verified in Resend.
CONTACT_FROM_EMAIL=website@hegtavic.com

# ── Spam protection ────────────────────────────────────────
# Optional. Without them the Turnstile widget is not rendered and
# verification is skipped in development, but FAILS CLOSED in a
# production build — set both before launch.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Specimen content ───────────────────────────────────────
# Renders the fabricated case studies and team members so the
# templates can be reviewed. Ignored on Vercel production builds and
# on any production build off Vercel — see lib/content/specimen.ts.
# ⛔ Never set this on the production deployment.
# NEXT_PUBLIC_SHOW_SPECIMEN=true
